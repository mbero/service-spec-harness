#!/usr/bin/env python3
"""Refuse a Bash command that would write into acceptance/.

A `PreToolUse` hook, registered on `Bash` in `.claude/settings.json`.

## What it is for, and what it is not for

`permissions.deny` covers the `Write` and `Edit` tools. It does not cover
`Bash`. Without this guard the only invisible route to the oracle is the shell,
which is exactly the route an agent reaches for when a path rule stops the
other two.

This is **not** the protection. `checks/oracle-integrity.sh` is: it hashes the
oracle and fails the build when the content moved without a seal, whatever tool
moved it. This guard only removes the quiet route, so that every write to the
oracle happens through `Write` or `Edit` and therefore lands in
`reports/agent-log.tsv` where you can see it.

It reads text, so a determined caller gets past it — base64, a variable, a
different spelling of the path. That is understood and it is why the hash check
exists. Treat a refusal here as a nudge, never as a security boundary.

## Decision rule

Deny when a command segment mentions the oracle path **and** names a way to
change it: a writing verb, an interpreter, a redirection into it, an in-place
flag, or a writing `git` subcommand. Allow everything else.

Err towards allowing. That is the opposite of what it looks like it should be,
and it is deliberate — see the comment on `WRITERS`. A false refusal teaches an
agent to route around the guard, and routing around is the behaviour the whole
mechanism exists to stop. A false allow costs nothing that
`checks/oracle-integrity.sh` does not already catch.

Always exits 0. A hook that can crash a tool call gets deleted the first time
it does.
"""

import json
import re
import sys

ORACLE = "acceptance"

# Named writers, and interpreters that can write without saying so.
#
# This list used to run the other way — an allowlist of readers, deny anything
# unlisted. That refused `du`, `n=$(grep -c ...)`, and a commit message that
# only named the oracle, all in one afternoon. The tail of harmless commands is
# endless, and every false refusal teaches an agent to route around the guard,
# which is the behaviour this whole mechanism exists to stop.
#
# So: deny the verbs that write, and the redirections. An unlisted writer gets
# through — `sponge`, some tool nobody here has heard of. That is acceptable
# only because this was never the boundary. `checks/oracle-integrity.sh` hashes
# the oracle and catches the change whatever wrote it.
WRITERS = {
    "cp", "mv", "rm", "rmdir", "mkdir", "touch", "tee", "dd", "truncate",
    "install", "ln", "chmod", "chown", "rsync", "patch", "sponge",
    "ed", "ex", "vi", "vim", "nano", "emacs",
    "tar", "zip", "unzip", "gzip", "gunzip",
    # Interpreters do anything at all, so the oracle in their argument is
    # enough on its own.
    "python", "python3", "perl", "ruby", "node", "sh", "bash", "zsh",
}

# `sed -n` prints, `sed -i` rewrites. Same shape for the others.
IN_PLACE = {"sed", "gsed", "awk", "yq", "jq", "perl"}

# git is both. `git diff acceptance/` is a read every reviewer runs; these
# subcommands put different bytes on disk.
GIT_WRITERS = {"checkout", "restore", "rm", "mv", "apply", "clean", "stash",
               "reset", "switch"}

# The harness's own tooling reads and seals the oracle on purpose.
ALLOWED_PREFIXES = ("checks/", "./checks/", "bin/", "./bin/")

# A command substitution is a command, so it gets its own segment. Without
# `$(` here, `n=$(grep -c x acceptance/cases/a.yaml)` reads as one segment whose
# leading word is `-c`, and a plain count gets refused.
SPLIT = re.compile(r"\|\||&&|\$\(|[;|`\n]")
ENV_ASSIGN = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")
HEREDOC = re.compile(r"<<-?\s*(['\"]?)([A-Za-z_][A-Za-z0-9_]*)\1")


def strip_heredocs(command):
    """Drop heredoc bodies and keep the line that opens them.

    `git commit -F - <<'MSG'` carries prose, and a sentence about the oracle is
    not a write to it. The opening line keeps its redirection, so
    `cat > acceptance/cases/a.yaml <<'EOF'` is still caught on that line.
    """
    kept, terminator = [], None
    for line in command.split("\n"):
        if terminator is not None:
            if line.strip().strip("'\"") == terminator:
                terminator = None
            continue
        kept.append(line)
        opener = HEREDOC.search(line)
        if opener:
            terminator = opener.group(2)
    return "\n".join(kept)


def leading_word(segment):
    """The command a segment runs, with env assignments and ( stripped."""
    words = segment.strip().lstrip("(").strip().split()
    for word in words:
        if ENV_ASSIGN.match(word):
            continue
        return word
    return ""


def is_write(segment):
    """True when this segment mentions the oracle and names a way to change it."""
    if ORACLE not in segment:
        return False

    word = leading_word(segment)
    if word.startswith(ALLOWED_PREFIXES):
        return False

    # A redirection into the oracle is a write however innocent the verb is:
    # `echo x > acceptance/cases/a.yaml` leads with `echo`.
    if re.search(r">>?\s*\S*" + ORACLE, segment):
        return True

    base = word.rsplit("/", 1)[-1]
    if base in WRITERS:
        return True
    if base in IN_PLACE and re.search(r"\s-\w*i\b", segment):
        return True
    if base == "git":
        words = segment.split()
        return any(w in GIT_WRITERS for w in words[1:4])
    return False


def main():
    try:
        payload = json.load(sys.stdin)
    except Exception:
        return
    if not isinstance(payload, dict):
        return
    if (payload.get("tool_name") or "") != "Bash":
        return

    args = payload.get("tool_input") or {}
    command = args.get("command") if isinstance(args, dict) else ""
    if not command or ORACLE not in command:
        return

    command = strip_heredocs(command)
    if ORACLE not in command:
        return

    offending = [seg for seg in SPLIT.split(command) if is_write(seg)]
    if not offending:
        return

    reason = (
        "acceptance/ is the oracle. Writing it through the shell leaves no "
        "record a reviewer can read. Use the Write or Edit tool instead — "
        "those are logged in reports/agent-log.tsv, and "
        "checks/oracle-integrity.sh will still fail the build if what you "
        "wrote was never approved and sealed. Refused segment: "
        + offending[0].strip()[:160]
    )
    print(json.dumps({
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": reason,
        }
    }))


if __name__ == "__main__":
    try:
        main()
    except Exception:
        pass
    sys.exit(0)
