#!/usr/bin/env python3
"""Agent run log — who did what, in order.

The harness runs five agents, one at a time, driven by slash commands. Nothing
in `state/` records the author or the reviewer: that file is the orchestrator's
ledger of landed `Sxx` steps, not a trace. This script is the trace.

It is fed by hooks in `.claude/settings.json`, so it records what actually
happened rather than what an agent said it did. Stdlib only, and it never calls
`bin/py`: a hook runs on every file write, and `uv run --locked` on that path
would add seconds per edit. It needs no third-party module, so the rule that
sends every check through `bin/py` does not buy anything here.

    bin/agent-log hook          read one hook event on stdin and append it
    bin/agent-log note TEXT     append a milestone by hand
    bin/agent-log show [-n N]   the readable timeline
    bin/agent-log raw           the TSV, unrendered
    bin/agent-log clear         truncate the log

`hook` ALWAYS exits 0. A logger that can block a tool call is a logger that
gets removed the first time it has a bug.

## What is recorded, and what is inferred

Recorded, from the hook payload, never guessed:

  start   a Task tool call began     — carries the real `subagent_type`
  end     that Task tool call returned — carries the same name
  write   a Write/Edit landed        — carries the file path
  bash    a Bash command ran         — carries the command
  note    a human or agent milestone

**Attribution is by time interval, not by transcript.** A `write` between a
`start` and its `end` belongs to the agent that `start` named: the parent is
blocked inside the Task call for exactly that span, so nothing else could have
written. Outside every interval, the work is the main session's.

The first version of this script attributed by `stream` — 8 characters of a
hash of the transcript path — on the assumption that a subagent reports its own
transcript. Measured against a real 259-row log, that assumption is false:
every row, parent and subagent alike, carried **one** stream. The column is
still recorded, because it costs nothing and may separate streams on another
version, but nothing depends on it any more.

`SubagentStop` is not used, and `.claude/settings.json` no longer registers it.
In the same log it fired **118 times for 2 subagents** — roughly once every 30
seconds of a subagent's life, not once at its end. A signal that fires 59 times
per event cannot close an interval.

Overlap: two `start`s open at once means the intervals nest, and a write in the
inner one could belong to either agent. `show` says so rather than presenting
the guess as a fact. The harness runs agents one at a time, which
`state/build-state.yaml` `current` enforces, so this should stay rare.

Set `AGENT_LOG` to point the log somewhere else. `checks/agent-log-cases.sh`
uses it to feed synthetic payloads through this script without touching the
real log.
"""

import hashlib
import json
import os
import sys
import time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
LOG = os.environ.get("AGENT_LOG") or os.path.join(ROOT, "reports", "agent-log.tsv")

MAX_DETAIL = 160
MAIN = "main"


def _now():
    return time.strftime("%Y-%m-%dT%H:%M:%S")


def _clean(text, limit=MAX_DETAIL):
    s = " ".join(str(text or "").split())
    return s[: limit - 1] + "…" if len(s) > limit else s


def _stream(transcript_path):
    """Stable short id for one conversation. '' means the main session."""
    if not transcript_path:
        return MAIN
    return hashlib.sha1(str(transcript_path).encode("utf-8")).hexdigest()[:8]


def append(event, stream, actor, detail):
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    line = "\t".join((_now(), event, stream, actor or "-", _clean(detail)))
    with open(LOG, "a", encoding="utf-8") as fh:
        fh.write(line + "\n")


def cmd_hook():
    """Never raises, never blocks. Exit code is always 0."""
    try:
        payload = json.load(sys.stdin)
    except Exception:
        return
    if not isinstance(payload, dict):
        return

    event_name = payload.get("hook_event_name") or ""
    tool = payload.get("tool_name") or ""
    args = payload.get("tool_input") or {}
    if not isinstance(args, dict):
        args = {}
    stream = _stream(payload.get("transcript_path"))

    if event_name == "PreToolUse" and tool in ("Task", "Agent"):
        agent = args.get("subagent_type") or "general-purpose"
        append("start", stream, agent, args.get("description") or "")
        return

    if event_name == "SubagentStop":
        # Deliberately dropped. It fired 118 times for 2 subagents in a real
        # log, so it closes nothing. PostToolUse on Task closes the interval.
        return

    if event_name == "PostToolUse":
        if tool in ("Task", "Agent"):
            agent = args.get("subagent_type") or "general-purpose"
            append("end", stream, agent, args.get("description") or "")
            return
        if tool in ("Write", "Edit", "NotebookEdit"):
            path = args.get("file_path") or args.get("notebook_path") or ""
            rel = os.path.relpath(path, ROOT) if path.startswith(ROOT) else path
            append("write", stream, "-", "%s %s" % (tool.lower(), rel))
        elif tool == "Bash":
            command = args.get("command") or ""
            if _interesting(command):
                append("bash", stream, "-", command)
    return


# A log of every `ls` and `cat` is not a log anyone reads. Only commands that
# move the build forward are recorded: the gates, the build tool, and git.
INTERESTING = ("checks/", "./checks/", "bin/", "./bin/", "mvn", "./mvnw",
               "gradle", "./gradlew", "git ", "java ", "node ")


def _interesting(command):
    head = command.strip().lstrip("(").lstrip()
    return any(head.startswith(prefix) for prefix in INTERESTING)


def read_rows():
    if not os.path.exists(LOG):
        return []
    rows = []
    with open(LOG, encoding="utf-8") as fh:
        for raw in fh:
            parts = raw.rstrip("\n").split("\t")
            if len(parts) == 5:
                rows.append(dict(zip(("ts", "event", "stream", "actor", "detail"), parts)))
    return rows


def resolve(rows):
    """Attach an agent name to every row by time interval. See the docstring.

    A `start` opens an interval, the matching `end` closes it. Anything logged
    in between came from the named subagent, because the parent is blocked
    inside the Task call for that whole span. Anything outside is the main
    session's own work.

    Legacy `stop` rows, written by the old SubagentStop hook, are dropped: in
    practice that event fired dozens of times per subagent and closing on it
    would cut every interval short.
    """
    rows = [r for r in rows if r["event"] != "stop"]
    open_agents = []          # names spawned and not yet returned
    overlapped = False

    for row in rows:
        event = row["event"]
        if event == "start":
            if open_agents:
                overlapped = True
            open_agents.append(row["actor"])
            continue
        if event == "end":
            if row["actor"] in open_agents:
                open_agents.remove(row["actor"])
            elif open_agents:
                open_agents.pop()
            continue
        if row["actor"] == "-":
            row["actor"] = open_agents[-1] if open_agents else MAIN

    return rows, overlapped


def cmd_show(limit):
    rows = read_rows()
    if not rows:
        print("agent-log is empty: %s" % os.path.relpath(LOG, ROOT))
        print("Nothing has run since the last `bin/agent-log clear`.")
        return
    rows, overlapped = resolve(rows)
    if not rows:
        print("agent-log holds only legacy SubagentStop rows, which say nothing.")
        print("Run `bin/agent-log clear` and the next run records intervals.")
        return
    # Count over the WHOLE log, not the slice `-n` is about to print: the
    # unclosed `start` that makes the names wrong is usually scrolled off.
    unclosed = (sum(1 for r in rows if r["event"] == "start")
                - sum(1 for r in rows if r["event"] == "end"))
    if limit:
        rows = rows[-limit:]

    glyph = {"start": "▶", "end": "■", "write": "✎", "bash": "$", "note": "•"}
    width = max(len(r["actor"]) for r in rows)

    print("%-19s  %-*s  %s" % ("when", width, "agent", "what"))
    print("-" * (19 + 2 + width + 2 + 40))
    for row in rows:
        print("%-19s  %-*s  %s %s" % (
            row["ts"], width, row["actor"], glyph.get(row["event"], "?"), row["detail"] or row["event"]))

    if overlapped:
        print()
        print("WARNING: two agents overlapped. The agent name on a write line is")
        print("         inferred from spawn order and can be wrong here.")

    if unclosed > 0:
        print()
        print("WARNING: %d Task call(s) never recorded an `end`, so their interval" % unclosed)
        print("         never closes and later lines inherit that agent's name.")
        print("         A log written before the PostToolUse hook covered `Task`")
        print("         always looks like this. Run `bin/agent-log clear`.")


def main():
    argv = sys.argv[1:]
    cmd = argv[0] if argv else "show"

    if cmd == "hook":
        try:
            cmd_hook()
        except Exception:
            pass
        return 0
    if cmd == "note":
        append("note", MAIN, "operator", " ".join(argv[1:]))
        return 0
    if cmd == "raw":
        sys.stdout.write(open(LOG, encoding="utf-8").read() if os.path.exists(LOG) else "")
        return 0
    if cmd == "clear":
        if os.path.exists(LOG):
            os.remove(LOG)
        print("cleared %s" % os.path.relpath(LOG, ROOT))
        return 0
    if cmd == "show":
        limit = 0
        if "-n" in argv:
            try:
                limit = int(argv[argv.index("-n") + 1])
            except (IndexError, ValueError):
                limit = 0
        cmd_show(limit)
        return 0

    sys.stderr.write(__doc__.split("\n\n")[2] + "\n")
    return 2


if __name__ == "__main__":
    sys.exit(main())
